{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonic-ai-v3.local/schemas/evidence.schema.json",
  "title": "Sonic AI V3 Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "kind", "source", "observed_at", "confidence"],
  "properties": {
    "evidence_id": { "type": "string" },
    "kind": { "enum": ["deterministic_fact", "creator_statement", "behavior", "analysis", "external_reference", "outcome", "correction", "inference"] },
    "source": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "claim": { "type": "string" },
    "value": {},
    "scope": { "type": "string" },
    "valid_from": { "type": ["string", "null"], "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "type": ["string", "null"] },
    "related_entity_ids": { "type": "array", "items": { "type": "string" } }
  }
}
