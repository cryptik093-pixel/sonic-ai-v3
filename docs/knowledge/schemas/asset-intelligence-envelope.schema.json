{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega-house.online/schemas/sonic-ai/asset-intelligence-envelope.v1.json",
  "title": "Sonic AI V3 Canonical Asset Intelligence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "production_id",
    "asset_id",
    "asset",
    "lineage",
    "analysis",
    "evidence",
    "provenance",
    "rights"
  ],
  "properties": {
    "schema_id": { "const": "OH-M05" },
    "schema_version": { "const": "1.0.0" },
    "record_id": { "type": "string", "minLength": 1 },
    "production_id": { "type": "string", "minLength": 1 },
    "asset_id": { "type": "string", "minLength": 1 },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "class", "content_sha256", "media_type"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "class": {
          "enum": ["beat", "melody", "stem", "midi", "one_shot", "drum_loop", "preset", "preview", "document", "other"]
        },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "type": "string", "minLength": 1 }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation_type", "parent_asset_ids", "invalidation_state"],
      "properties": {
        "derivation_type": { "enum": ["original", "derived", "render", "export", "package"] },
        "parent_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "invalidation_state": { "enum": ["current", "stale", "unknown"] }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "defects"],
      "properties": {
        "measurement": { "type": ["object", "null"] },
        "defects": { "type": "array", "items": { "type": "object" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "refs"],
      "properties": {
        "state": { "enum": ["unvalidated", "validated", "historical", "not_applicable"] },
        "refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "method", "observed_at"],
      "properties": {
        "source_type": { "enum": ["runtime", "import", "archive", "manual"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rights_state_id", "license_id", "ai_ml_training_permission"],
      "properties": {
        "status": { "enum": ["unknown", "known"] },
        "rights_state_id": { "type": ["string", "null"] },
        "license_id": { "type": ["string", "null"] },
        "ai_ml_training_permission": { "enum": ["unknown", "permitted", "prohibited"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lineage": { "properties": { "derivation_type": { "const": "original" } } } } },
      "then": { "properties": { "lineage": { "properties": { "parent_asset_ids": { "maxItems": 0 } } } } }
    },
    {
      "if": { "properties": { "rights": { "properties": { "status": { "const": "unknown" } } } } },
      "then": {
        "properties": {
          "rights": {
            "properties": {
              "rights_state_id": { "type": "null" },
              "license_id": { "type": "null" },
              "ai_ml_training_permission": { "const": "unknown" }
            }
          }
        }
      }
    }
  ]
}
