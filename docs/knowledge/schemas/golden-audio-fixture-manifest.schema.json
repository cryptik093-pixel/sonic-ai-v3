{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega-house.online/schemas/sonic-ai/golden-audio-fixture-manifest.v1.json",
  "title": "Sonic AI V3 Golden Audio Fixture Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "production_id",
    "measurement_profile",
    "defect_taxonomy",
    "metadata_schema",
    "fixtures"
  ],
  "properties": {
    "schema_id": { "const": "OH-M03" },
    "schema_version": { "const": "1.0.0" },
    "production_id": { "type": "string", "minLength": 1 },
    "measurement_profile": { "const": "OH-M04" },
    "defect_taxonomy": { "const": "OH-M02" },
    "metadata_schema": { "const": "OH-M05" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "asset_id", "filename", "sha256", "purpose", "expected"],
        "properties": {
          "fixture_id": { "type": "string", "pattern": "^OH-FIX-" },
          "asset_id": { "type": "string", "pattern": "^OH-ASSET-" },
          "filename": { "type": "string", "pattern": "\\.wav$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "purpose": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample_rate_hz",
              "channels",
              "bit_depth",
              "frame_count",
              "duration_seconds",
              "sample_peak_dbfs",
              "rms_dbfs",
              "crest_factor_db",
              "full_scale_sample_count",
              "silent_sample_ratio",
              "stereo_correlation",
              "defect_codes"
            ],
            "properties": {
              "sample_rate_hz": { "type": "integer", "minimum": 1 },
              "channels": { "type": "integer", "minimum": 1 },
              "bit_depth": { "enum": [8, 16, 24, 32] },
              "frame_count": { "type": "integer", "minimum": 1 },
              "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
              "sample_peak_dbfs": { "type": ["number", "null"], "maximum": 0 },
              "rms_dbfs": { "type": ["number", "null"], "maximum": 0 },
              "crest_factor_db": { "type": ["number", "null"] },
              "full_scale_sample_count": { "type": "integer", "minimum": 0 },
              "silent_sample_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
              "stereo_correlation": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
              "defect_codes": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^OH-DEF-" }
              }
            }
          }
        }
      }
    }
  }
}
