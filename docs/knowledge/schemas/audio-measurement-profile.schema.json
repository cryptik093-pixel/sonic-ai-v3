{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omega-house.online/schemas/sonic-ai/audio-measurement-profile.v1.json",
  "title": "Sonic AI V3 Deterministic Audio Measurement Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "profile_version",
    "source",
    "format",
    "amplitude",
    "channels",
    "stereo",
    "loudness",
    "true_peak",
    "interpretation"
  ],
  "properties": {
    "profile_id": { "const": "OH-M04" },
    "profile_version": { "type": "string", "pattern": "^1\\." },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "container", "codec"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "container": { "const": "wav" },
        "codec": { "const": "pcm" }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate_hz", "channels", "bit_depth", "frame_count", "duration_seconds"],
      "properties": {
        "sample_rate_hz": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 },
        "bit_depth": { "enum": [8, 16, 24, 32] },
        "frame_count": { "type": "integer", "minimum": 0 },
        "duration_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "amplitude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_peak_dbfs",
        "rms_dbfs",
        "crest_factor_db",
        "full_scale_sample_count",
        "full_scale_sample_ratio",
        "near_full_scale_sample_count",
        "near_full_scale_sample_ratio",
        "silence_threshold_dbfs",
        "silent_sample_ratio"
      ],
      "properties": {
        "sample_peak_dbfs": { "type": ["number", "null"], "maximum": 0 },
        "rms_dbfs": { "type": ["number", "null"], "maximum": 0 },
        "crest_factor_db": { "type": ["number", "null"] },
        "full_scale_sample_count": { "type": "integer", "minimum": 0 },
        "full_scale_sample_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "near_full_scale_sample_count": { "type": "integer", "minimum": 0 },
        "near_full_scale_sample_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "silence_threshold_dbfs": { "const": -60.0 },
        "silent_sample_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_index", "sample_peak_dbfs", "rms_dbfs", "dc_offset_mean"],
        "properties": {
          "channel_index": { "type": "integer", "minimum": 0 },
          "sample_peak_dbfs": { "type": ["number", "null"], "maximum": 0 },
          "rms_dbfs": { "type": ["number", "null"], "maximum": 0 },
          "dc_offset_mean": { "type": "number", "minimum": -1, "maximum": 1 }
        }
      }
    },
    "stereo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_status", "correlation"],
      "properties": {
        "correlation_status": { "enum": ["measured", "unavailable", "not_applicable"] },
        "correlation": { "type": ["number", "null"], "minimum": -1, "maximum": 1 }
      }
    },
    "loudness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrated_lufs", "status", "reason"],
      "properties": {
        "integrated_lufs": { "type": ["number", "null"] },
        "status": { "enum": ["measured", "unavailable"] },
        "reason": { "type": "string" }
      }
    },
    "true_peak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dbtp", "status", "reason"],
      "properties": {
        "dbtp": { "type": ["number", "null"] },
        "status": { "enum": ["measured", "unavailable"] },
        "reason": { "type": "string" }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "not_performed" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
