# Sonic AI V3 local workbench
# Copy to apps/api/.env only when running the API directly from source.
# The desktop launcher configures its own local token and data folder.

# Optional data overrides. By default source runs use apps/api/data/sonic_ai.db
# and the configured event database under apps/api/storage/.
# SONIC_DATA_DIR=/absolute/path/to/sonic-data
# SONIC_DB_PATH=/absolute/path/to/sonic-data/sonic_ai.db
# SONIC_EVENT_DB=/absolute/path/to/sonic-data/sonic_events.sqlite3

# Required for direct API use; the desktop launcher creates a private local token.
# SONIC_CONTROL_PLANE_TOKEN=generate-a-unique-random-secret

# Optional OpenAI connection for grounded run coaching only. Local MIDI creation,
# analysis, packaging and release drafts do not require this key.
# SONIC_OPENAI_API_KEY=
# SONIC_OPENAI_MODEL=gpt-4o
# SONIC_OPENAI_BASE_URL=https://api.openai.com/v1

# Shopify webhook ingestion settings belong to the separate integration API.
# They are not required for workbench CSV drafts and do not enable workbench
# publication. Configure secrets only when intentionally using that API.
# SONIC_SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
# SONIC_SHOPIFY_WEBHOOK_SECRET=
# SONIC_SHOPIFY_API_VERSION=2026-07
